{
  "name": "northgate-console-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript UI and API tests for Northgate Console",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:green": "playwright test --grep-invert @planted",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep-invert @planted",
    "test:planted": "playwright test --grep @planted",
    "test:api": "playwright test --project=api --grep-invert @planted",
    "test:viewport": "playwright test --project=viewport",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results -o allure-report --clean",
    "allure:open": "allure open allure-report"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.13.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.11.0",
    "typescript": "5.9"
  }
}
